# Copia este archivo como .env y llena tus valores reales SOLO en .env
# (.env está en .gitignore y nunca se sube). No pongas valores reales aquí.

# Obligatorio para el agente: clave de https://console.anthropic.com
ANTHROPIC_API_KEY=pon-aqui-tu-clave
# Opcional: otro modelo de Claude (por defecto claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Opcional: otro CSV del catálogo (por defecto datos/catalogo.csv)
# CATALOGO_CSV=datos/catalogo.csv

# Clave para ver el panel del dueño: http://127.0.0.1:8000/?panel=<esta clave>
PANEL_CLAVE=inventa-una-clave

# Opcional, solo para conectar WhatsApp real (docs/agente_whatsapp.md, paso B)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Futuro (reservas en base de datos)
SUPABASE_URL=
SUPABASE_KEY=
